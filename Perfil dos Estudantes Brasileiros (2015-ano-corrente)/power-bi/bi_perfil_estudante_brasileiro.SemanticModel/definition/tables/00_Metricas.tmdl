table 00_Metricas
	lineageTag: f169ddbf-8c7c-42c1-844d-b5aafb2d719d

	measure Total_Estudantes = sum(bd_perfil_estudante_brasileiro[qtd_estudantes])
		lineageTag: 10fb7981-941e-4791-a3e5-809191405b4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ensino_Fundamental =
			
			CALCULATE (
			    [Total_Estudantes],
			    bd_perfil_estudante_brasileiro[nivel_ensino] = "ENSINO_FUNDAMENTAL"
			)
		formatString: 0
		lineageTag: 26c875ab-fd4a-45ad-ba32-3d4aef046c61

	measure Ensino_Medio =
			
			CALCULATE (
			    [Total_Estudantes],
			    bd_perfil_estudante_brasileiro[nivel_ensino] = "ENSINO_MEDIO"
			)
		formatString: 0
		lineageTag: 1a61c7ff-9089-4d06-9b58-7a36dba92ed3

	measure Ensino_Superior =
			
			CALCULATE (
			    [Total_Estudantes],
			    bd_perfil_estudante_brasileiro[nivel_ensino] = "ENSINO_SUPERIOR"
			)
		formatString: 0
		lineageTag: 93e107ca-ecd2-46f6-9d61-aa7940e34daa

	partition 00_Metricas = m
		mode: import
		queryGroup: '04 - Métricas'
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

